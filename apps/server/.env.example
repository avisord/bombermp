PORT=3001
COOKIE_SECRET=change-me-in-production
CLIENT_ORIGIN=https://bombermb.avinashjha.space
NODE_ENV=production

# Optional. When unset, the server runs in-memory only (no player or
# match-history persistence). Set this to a Mongo connection string to
# enable persistence — useful for production deployments, not required
# for self-hosting.
# MONGODB_URI=mongodb://localhost:27017/bombermp
